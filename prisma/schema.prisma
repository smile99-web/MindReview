generator client {
  provider      = "prisma-client-js"
  // 跨平台 build：Mac 上 build 也要生成 linux binary engine，
  // 否则 prisma client 在 VPS（debian-openssl-3.0.x）上跑不起来。
  // 加上 native 让本地 dev 仍能用 mac 引擎。
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  name         String?
  grade        String? // 年级，如 "初二"
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewTasks       ReviewTask[]
  reviewLogs        ReviewLog[]
  mistakes          Mistake[]
  mistakeLogs       MistakeLog[]
  knowledgeProgress UserKnowledgeProgress[]
  audioAssets       AudioAsset[]
  refreshTokens     RefreshToken[]
  chatConversations ChatConversation[]
  studyTimeLogs     StudyTimeLog[]
  examUploads       ExamUpload[]
  docUploads        DocUpload[]
  textbookUploads  TextbookUpload[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique // 数学/物理/化学/历史/道法
  icon        String? // 图标 emoji
  colorClass  String? // Tailwind 颜色类名
  description String?
  createdAt   DateTime @default(now())

  chapters        Chapter[]
  knowledgeNodes  KnowledgeNode[]
  mistakes        Mistake[]
  textbookUploads TextbookUpload[]
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  parentId  String?
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent         Chapter?        @relation("ChapterHierarchy", fields: [parentId], references: [id])
  children       Chapter[]       @relation("ChapterHierarchy")
  knowledgeNodes KnowledgeNode[]
}

model KnowledgeNode {
  id                 String                       @id @default(cuid())
  subjectId          String
  chapterId          String?
  parentId           String?
  title              String
  summary            String? // 简明解释
  // 学段标签 — 让 subjects/[id] 页面按"七年级上/下/八年级上/下..."
  // 分组章节，而不再依赖 sortOrder 重置猜测（math 数据混乱时猜
  // 不准）。LLM 在 generateChapterKnowledge 时会填入"七年级上"、
  // "八年级下"等。旧数据为 null，会在 subjects/[id] 退回到按
  // sortOrder 排序（不再被错切）。
  gradeLevel         String?  // "七年级上" | "七年级下" | "八年级上" | "八年级下" | "九年级上" | "九年级下" | "高一" | "高二" | "高三"
  keywords           String[]                     @default([])
  prerequisites      String[]                     @default([])
  commonMistakes     String[]                     @default([])
  typicalQuestions   String[]                     @default([])
  difficulty         Int                          @default(3) // 1-5
  cognitiveLoad      Int                          @default(3) // 1-5
  icapLevel          String                       @default("Active") // Passive/Active/Constructive/Interactive
  masteryLevel       Int                          @default(0) // 0-100
  // SM-2 记忆调度字段
  repetitions        Int                          @default(0) // 连续正确回忆次数
  easeFactor         Float                        @default(2.5) // 难度系数，最低 1.3
  intervalDays       Int                          @default(0) // 当前复习间隔（天）
  nextReviewAt       DateTime? // 下次复习时间
  lastReviewAt       DateTime? // 上次复习时间
  forgetRisk         Float                        @default(0) // 遗忘风险 0-1
  representationType String? // formula/image/step/timeline/causal/mindmap etc.
  representationData Json? // 表征数据
  embedding          Unsupported("vector(1536)")? // pgvector 语义搜索嵌入
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  subject        Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter        Chapter?                @relation(fields: [chapterId], references: [id])
  parent         KnowledgeNode?          @relation("KnowledgeHierarchy", fields: [parentId], references: [id])
  children       KnowledgeNode[]         @relation("KnowledgeHierarchy")
  outgoingEdges  KnowledgeEdge[]         @relation("EdgeFrom")
  incomingEdges  KnowledgeEdge[]         @relation("EdgeTo")
  knowledgeCards KnowledgeCard[]
  questions      Question[]
  mistakes       Mistake[]
  mistakeLogs    MistakeLog[]
  reviewLogs     ReviewLog[]
  reviewTasks    ReviewTask[]
  userProgress   UserKnowledgeProgress[]
}

model KnowledgeEdge {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  relationType String // contains/prerequisite/cause/compare/formula/experiment/mistake/questionType
  label        String?
  createdAt    DateTime @default(now())

  from KnowledgeNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   KnowledgeNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
}

model KnowledgeCard {
  id              String   @id @default(cuid())
  knowledgeNodeId String
  cardType        String // summary/formula/diagram/timeline/template/mistake
  title           String
  content         String
  imageUrl        String?
  audioUrl        String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)
}

model Question {
  id              String   @id @default(cuid())
  knowledgeNodeId String
  questionType    String // multiple_choice/fill_blank/true_false/short_answer/variant
  icapLevel       String   @default("Active") // Passive/Active/Constructive/Interactive
  stem            String // 题干
  options         Json? // [{label: "A", text: "..."}]
  answer          String // 正确答案
  explanation     String? // 解析
  difficulty      Int      @default(3) // 1-5
  cognitiveLoad   Int      @default(3) // 1-5
  audioUrl        String?
  createdAt       DateTime @default(now())

  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)
}

model Mistake {
  id              String   @id @default(cuid())
  userId          String
  knowledgeNodeId String?
  subjectId       String?
  questionText    String // 原题文本（或图片描述）
  wrongAnswer     String? // 错误答案
  correctAnswer   String // 正确答案
  mistakeType     String? // conceptual/calculation/careless/application
  analysis        String? // AI错因分析
  resolved        Boolean  @default(false)
  // FSRS-style scheduling state. We model stability + difficulty +
  // repetition/lapse counters in the same shape FSRS uses so we can
  // re-schedule the mistake review at the right Ebbinghaus-style
  // forgetting-curve point.
  //
  //   state: 'new' (never reviewed), 'learning' (recently wrong /
  //   just-created), 'review' (graduated after several corrects),
  //   'relearning' (was in 'review' then got wrong again).
  //   stability:  "memory half-life" in days (FSRS S value).
  //   difficulty: 1-10 FSRS D value (default 5).
  //   reps: how many times the student has reviewed this mistake.
  //   lapses: how many times they got it wrong.
  //   lastReviewAt: when the student last attempted this mistake.
  //   nextReviewAt: when FSRS says to re-show this mistake.
  //   history: per-attempt log (rating + time) for analytics.
  state          String   @default("new")
  stability      Float    @default(1)
  difficulty     Float    @default(5)
  reps           Int      @default(0)
  lapses         Int      @default(0)
  lastReviewAt   DateTime?
  nextReviewAt   DateTime?
  // JSON array of {at, rating, durationMs?} entries — one per
  // review attempt. Bounded to the last 20 entries in the API.
  history        Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode? @relation(fields: [knowledgeNodeId], references: [id])
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model ReviewTask {
  id              String    @id @default(cuid())
  userId          String
  knowledgeNodeId String
  taskType        String // passive/active/constructive/interactive
  dueDate         DateTime
  completed       Boolean   @default(false)
  score           Int? // 得分
  feedback        String? // AI反馈
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)
}

model ReviewLog {
  id               String   @id @default(cuid())
  userId           String
  knowledgeNodeId  String?
  action           String // reviewed/solved/mistake/mastered
  masteryBefore    Int?
  masteryAfter     Int?
  // SM-2 快照
  quality          Int? // 回忆质量 0-5
  easeFactorBefore Float?
  easeFactorAfter  Float?
  intervalBefore   Int? // 复习前间隔（天）
  intervalAfter    Int? // 复习后间隔（天）
  repetitions      Int? // 本次复习时的连续正确次数
  forgetRisk       Float? // 遗忘风险快照
  durationSeconds  Int?
  createdAt        DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode? @relation(fields: [knowledgeNodeId], references: [id])
  mistakeLogs   MistakeLog[]
}

model MistakeLog {
  id              String    @id @default(cuid())
  userId          String
  knowledgeNodeId String?
  reviewLogId     String?
  mistakeType     String // conceptual/calculation/careless/application
  severity        Int       @default(1) // 1-5 错误严重程度
  triggerCount    Int       @default(1) // 同类错误触发次数
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode? @relation(fields: [knowledgeNodeId], references: [id])
  reviewLog     ReviewLog?     @relation(fields: [reviewLogId], references: [id])
}

model UserKnowledgeProgress {
  id                      String    @id @default(cuid())
  userId                  String
  knowledgeNodeId         String
  masteryLevel            Int       @default(0)
  repetitions             Int       @default(0)
  easeFactor              Float     @default(2.5)
  intervalDays            Int       @default(0)
  nextReviewAt            DateTime?
  lastReviewAt            DateTime?
  forgetRisk              Float     @default(0)
  // 学习完成进度（首次完成时记录时间戳；可重复学习，不重置）
  readCompletedAt         DateTime?
  practicedCompletedAt    DateTime?
  constructiveCompletedAt DateTime?
  interactiveCompletedAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeNodeId])
  @@index([userId, nextReviewAt])
  @@index([knowledgeNodeId])
}

model AiGenerationLog {
  id            String   @id @default(cuid())
  generatorType String // llm/tts/image
  model         String // deepseek-chat/volcano_tts/seedream-5-0
  prompt        String
  response      String?
  status        String // pending/processing/success/failed
  resultUrl     String?
  errorMessage  String?
  tokensUsed    Int?
  durationMs    Int?
  createdAt     DateTime @default(now())
}

model AudioAsset {
  id           String   @id @default(cuid())
  userId       String?
  contentType  String // card/explanation/summary/question
  contentRefId String? // 关联的知识卡片/题目ID
  text         String // 原文
  audioUrl     String
  durationMs   Int?
  voiceType    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model ImageAsset {
  id           String   @id @default(cuid())
  imageType    String // knowledge/experiment/timeline/force/reaction/portrait
  prompt       String
  imageUrl     String
  contentRefId String? // 关联的知识卡片ID
  status       String   @default("pending") // pending/processing/success/failed
  errorMessage String?
  createdAt    DateTime @default(now())
}

model ApiKey {
  id        String    @id @default(cuid())
  service   String // llm / tts / image
  key       String // 加密存储的 API Key
  baseUrl   String? // 自定义 Base URL
  model     String? // 自定义 Model
  isActive  Boolean   @default(true)
  lastTest  DateTime?
  testOk    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([service])
}

// AI 多轮问答会话 —— 学生在 /cards 等页面遇到不懂概念时与 AI 老师的对话。
// 多轮历史持久化便于跨刷新、跨设备继续聊，也方便后续接入学习报告。
model ChatConversation {
  id              String   @id @default(cuid())
  userId          String
  knowledgeNodeId String? // 可选：发起会话时所在知识点（删除节点时置空，保留历史）
  title           String   @default("新对话")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user / assistant / system
  content        String // 文本内容（assistant 同时承担 image prompt 描述）
  imageUrl       String? // assistant 触发图片生成时，存生成结果 URL
  imagePrompt    String? // 触发本次图片生成所用的提示词（便于复用 / 重生成）
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// 学习时长心跳日志 —— 客户端每 ~15s 发一次心跳，每条记录一段连续活跃时间。
// 汇总后在 /analytics 看板显示近 30 天学习总时长。
// 30 秒无活动（点击 / 滚动 / 输入）即停止发心跳，自然反映"实际专注时间"。
model StudyTimeLog {
  id              String   @id @default(cuid())
  userId          String
  startedAt       DateTime // 本段活跃起点
  endedAt         DateTime // 本段活跃终点（≈ 发心跳时刻）
  durationSeconds Int // endedAt - startedAt，单位秒
  source          String   @default("activity-tracker") // 预留：以后接 ICAP / 答题计时
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, createdAt])
}

// 上传试卷/练习题图片 + OCR + 拆解 + 练习
// 工作流：
//   1. 前端 POST multipart image → /api/exam/upload
//      后端 OCR（vision LLM）→ ocrText 落库 → 返回 {id, ocrText}
//   2. 前端 POST {examId} → /api/exam/analyze
//      后端把 ocrText 喂给 decomposeKnowledge → knowledgePoints 落库
//   3. 前端 POST {examId} → /api/exam/practice
//      后端用 knowledgePoints 当作 conditioning context，调用
//      generateQuestions 生成类似题 → practiceQuestions 落库
//   4. 前端把整张试卷（id）展示给用户：OCR 文字 + 知识点卡片 + 类似题练习
model ExamUpload {
  id                String   @id @default(cuid())
  userId            String
  // 原图（压缩后的 JPEG/PNG 字节）。bytea 字段，~50KB 上限。
  imageData         Bytes?
  // 推断的学科（OCR 后 LLM 一并返回）。空表示未识别。
  subjectName       String?
  // Vision LLM 提取的题目文字（保留 LaTeX 标记）
  ocrText           String
  // 知识点拆解（decomposeKnowledge 输出）
  knowledgePoints   Json     @default("[]")
  // 类似题（generateQuestions 输出）
  practiceQuestions Json     @default("[]")
  // 用户在 UI 上输入的笔记 / 答案
  userNotes         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DocUpload {
  id                String   @id @default(cuid())
  userId            String
  fileName          String
  subjectName       String?
  content           String
  knowledgePoints   Json     @default("[]")
  practiceQuestions Json     @default("[]")
  userNotes         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 教材上传（PDF / DOCX / TXT）。
// 复用 Subject→Chapter→KnowledgeNode 的层级结构：用户上传一个
// 教材 PDF 后，pipeline 拆出 chapters，导入到对应 Subject 下。
model TextbookUpload {
  id                String   @id @default(cuid())
  userId            String
  subjectId         String?
  fileName          String
  fileType          String // pdf / docx / txt
  content           String
  // 是否已触发 chapters 拆解（teachflow 拆解出 N 个 chapter 标题）
  decomposedChapters Json   @default("[]")
  // 是否已触发某个 chapter 的 knowledge points 拆解（cascaded）
  // Each entry: { chapterTitle, status: 'pending' | 'imported' | 'failed' }
  chapterImports     Json   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
